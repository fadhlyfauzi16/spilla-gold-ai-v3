generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String          @id @default(uuid())
  fullName       String
  email          String          @unique
  password       String
  role           Role            @default(USER)
  status         Status          @default(ACTIVE)
  accountType    String?         @default("Trader Individu")
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  aiAnalysisLogs AiAnalysisLog[]
  creditLedgers  CreditLedger[]
  creditTopUps   CreditTopUp[]
  creditWallet   CreditWallet?
}

model CreditWallet {
  id            String         @id @default(uuid())
  userId        String         @unique
  balance       Float          @default(0.0)
  totalTopUp    Float          @default(0.0)
  totalUsed     Float          @default(0.0)
  totalAnalysis Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ledgers       CreditLedger[]
  topups        CreditTopUp[]
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CreditLedger {
  id            String           @id @default(uuid())
  userId        String
  walletId      String
  type          CreditLedgerType @default(TOPUP)
  amount        Float
  balanceBefore Float
  balanceAfter  Float
  referenceId   String?
  description   String
  performedBy   String?
  createdAt     DateTime         @default(now())
  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet        CreditWallet     @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([walletId])
  @@index([createdAt])
}

model CreditTopUp {
  id              String          @id @default(uuid())
  userId          String
  walletId        String?
  amountIdr       Float
  creditRequested Float
  paymentMethod   String          @default("MANUAL_BANK_TRANSFER")
  bankName        String          @default("BCA (Bank Central Asia)")
  accountNumber   String          @default("0771360059")
  accountName     String          @default("Sri Hartono")
  status          TopUpStatusEnum @default(PENDING)
  referenceNotes  String?
  adminNotes      String?
  confirmedBy     String?
  confirmedByName String?
  confirmedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          CreditWallet?   @relation(fields: [walletId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AiAnalysisLog {
  id           String   @id @default(uuid())
  userId       String
  symbol       String   @default("XAUUSD")
  timeframe    String   @default("H1")
  analysisType String   @default("LIVE_AI_ANALYSIS")
  creditCost   Float    @default(100.0)
  status       String   @default("SUCCESS")
  errorMessage String?
  snapshotId   String?
  signalId     String?
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

model CreditPaymentSetting {
  id            String   @id @default(uuid())
  bankName      String   @default("BCA (Bank Central Asia)")
  accountNumber String   @default("0771360059")
  accountName   String   @default("Sri Hartono")
  instructions  String
  isActive      Boolean  @default(true)
  updatedAt     DateTime @updatedAt
}

model CreditAuditLog {
  id            String   @id @default(uuid())
  adminUserId   String
  action        String
  targetUserId  String?
  amount        Float?
  balanceBefore Float?
  balanceAfter  Float?
  referenceId   String?
  metadata      String?
  createdAt     DateTime @default(now())

  @@index([adminUserId])
  @@index([targetUserId])
  @@index([createdAt])
}

model TradingAccount {
  id                 String                    @id @default(uuid())
  userId             String?
  accountNumber      String                    @unique
  brokerServer       String                    @default("AIMS-Live")
  accountType        String                    @default("STANDARD")
  currency           String                    @default("USD")
  balance            Float                     @default(0.0)
  equity             Float                     @default(0.0)
  freeMargin         Float                     @default(0.0)
  leverage           Int                       @default(0)
  isLive             Boolean                   @default(false)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  executionEnabled   Boolean                   @default(false)
  lastHeartbeat      DateTime?
  symbol             String?                   @default("XAUUSD")
  workerId           String?
  workerOnline       Boolean                   @default(false)
  broker             String?                   @default("AIMS")
  floatingProfitLoss Float?                    @default(0.0)
  margin             Float?                    @default(0.0)
  marginLevel        Float?                    @default(0.0)
  tradePlans         TradePlanSnapshot[]
  credential         TradingAccountCredential?
}

model TradingAccountCredential {
  id                String         @id @default(uuid())
  tradingAccountId  String         @unique
  encryptedPassword String
  iv                String
  authTag           String
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  tradingAccount    TradingAccount @relation(fields: [tradingAccountId], references: [id], onDelete: Cascade)
}

model TradePlanSnapshot {
  id                    String              @id @default(uuid())
  tradePlanId           String              @unique
  analysisId            String
  signalId              String
  riskValidationId      String
  tradingAccountId      String?
  symbol                String              @default("XAUUSD")
  timeframe             String              @default("H1")
  marketCondition       MarketConditionEnum @default(BULLISH)
  action                TradingActionEnum   @default(BUY)
  confidence            Int                 @default(85)
  marketPriceAtCreation Float
  bid                   Float
  ask                   Float
  spreadPoints          Int                 @default(20)
  entryZoneMin          Float
  entryZoneMax          Float
  entryPrice            Float
  stopLoss              Float
  takeProfit1           Float
  takeProfit2           Float
  takeProfit3           Float?
  riskRewardRatio       Float
  riskPercent           Float               @default(1.0)
  riskAmount            Float               @default(100.0)
  calculatedLot         Float               @default(0.10)
  normalizedLot         Float               @default(0.10)
  estimatedLossAtSl     Float               @default(100.0)
  isEligible            Boolean             @default(true)
  validationStatus      String              @default("APPROVED")
  validationReasons     String
  validationChecks      String
  keyDrivers            String
  invalidationCondition String
  marketNarrative       String
  userConfirmed         Boolean             @default(false)
  planStatus            PlanStatusEnum      @default(PROPOSED)
  mt5Ticket             String?
  executedAt            DateTime?
  actualFillPrice       Float?
  createdAt             DateTime            @default(now())
  expiresAt             DateTime
  tradingAccount        TradingAccount?     @relation(fields: [tradingAccountId], references: [id])
}

model CopilotAuditLog {
  id              String   @id @default(uuid())
  timestamp       DateTime @default(now())
  eventType       String
  userId          String?
  accountId       String?
  symbol          String   @default("XAUUSD")
  relatedEntityId String?
  idempotencyKey  String?
  status          String   @default("INFO")
  reason          String?
  details         String?
}

enum Role {
  USER
  ADMIN
}

enum Status {
  ACTIVE
  PENDING
  SUSPENDED
}

enum MarketConditionEnum {
  BULLISH
  BEARISH
  SIDEWAY
  NO_TRADE
}

enum TradingActionEnum {
  BUY
  SELL
  NONE
}

enum PlanStatusEnum {
  PROPOSED
  APPROVED
  REJECTED
  EXECUTED
  EXPIRED
}

enum CreditLedgerType {
  TOPUP
  AI_USAGE
  ADMIN_ADJUSTMENT
  REFUND
  IMPORT_ADJUSTMENT
  RESTORE
  RECONCILIATION_REPAIR
}

enum TopUpStatusEnum {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}


